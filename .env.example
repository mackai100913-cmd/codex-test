# === Gemini API ===
# 取得方法は docs/SETUP.md を参照（Google AI Studio で発行）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 画像生成API: true で料理写真も自動生成（モードA・要 請求有効化）。
# false なら自分でGeminiアプリ等で作った画像を「素材」フォルダから使う（モードB・無料）。
GEMINI_IMAGE_ENABLED=false

# 使用する画像生成モデル（モードAのとき）
#   高画質: gemini-3-pro-image-preview（Nano Banana Pro）
#   安価:   gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# レシピ本文の生成に使うテキストモデル（未設定でもサンプルで動作）
GEMINI_TEXT_MODEL=gemini-2.5-flash

# 画像審査（デザイン責任者）に使うビジョン対応モデル
GEMINI_REVIEW_MODEL=gemini-flash-latest

# 1回の実行で生成する投稿数
POSTS_PER_RUN=1

# モード②(ブラウザ自動化)で合流するジェミニの既存チャット名。
# 会長が用意した共通チャットの名前に合わせる（CLIの --chat でも上書き可）。
GEMINI_CHAT_NAME=TikTok画像自動化

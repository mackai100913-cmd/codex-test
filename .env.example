# === Gemini 画像生成 API ===
# 取得方法は docs/SETUP.md を参照（Google AI Studio で無料発行）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 使用する画像生成モデル（Nano Banana Pro = gemini-3-pro-image-preview）
# 安価に試す場合は gemini-2.5-flash-image-preview も可
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# キャプション等の文言生成に使うテキストモデル（任意・未設定でもテンプレで動作）
GEMINI_TEXT_MODEL=gemini-3-pro

# 1日に生成する投稿数
POSTS_PER_RUN=2
